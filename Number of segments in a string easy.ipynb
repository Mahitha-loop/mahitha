    "def countSegments(s):\n",
    "    return len(s.split())\n",
    "\n",
    "\n",
    "# Example 1\n",
    "s = \"Hello, my name is John\"\n",
    "print(countSegments(s))  # Output: 5\n",
    "\n",
    "# Example 2\n",
    "s = \"Hello\"\n",
    "print(countSegments(s))  # Output: 1"
   ]
